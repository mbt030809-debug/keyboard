<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MbtKeyboard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/brand_on</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/brand_on</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_container</item>
        <item name="android:windowBackground">@color/surface_page</item>
        <item name="colorSurface">@color/surface_page</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorSurfaceContainerLowest">@color/surface_card</item>
        <item name="colorSurfaceContainerLow">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="colorSurfaceContainerHighest">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="colorOutlineVariant">@color/hairline</item>
        <item name="android:statusBarColor">@color/surface_page</item>
        <item name="android:navigationBarColor">@color/surface_page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 권한 요청용 투명 화면 -->
    <style name="Theme.MbtKeyboard.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- IME 윈도우: Android 12+ 실시간 배경 가우시안 블러(setBackgroundBlurRadius)가 동작하도록 windowIsTranslucent=true 지정 -->
    <style name="Theme.MbtKeyboard.Ime" parent="@android:style/Theme.DeviceDefault.InputMethod">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- One UI / M3 Expressive tonal card: generous 24dp radius, soft surface contrast, no harsh 1px outline -->
    <style name="Widget.Mbt.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Section header: clean indented One UI group title -->
    <style name="Widget.Mbt.SectionLabel" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Card title -->
    <style name="Widget.Mbt.CardTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Card description -->
    <style name="Widget.Mbt.CardDesc" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Slider / setting row label -->
    <style name="Widget.Mbt.RowLabel" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Expressive tonal pill readout for live numeric values -->
    <style name="Widget.Mbt.KeycapValue" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:background">@drawable/bg_value_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Primary pill button: 48dp native touch target -->
    <style name="Widget.Mbt.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Secondary tonal pill button: 48dp native touch target -->
    <style name="Widget.Mbt.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/surface_raised</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Circular/pill tonal stepper button -->
    <style name="Widget.Mbt.Button.Stepper" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/surface_raised</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Rounded pill filter chip -->
    <style name="Widget.Mbt.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">18dp</item>
        <item name="chipStrokeColor">@color/hairline</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/surface_raised</item>
        <item name="chipMinHeight">38dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
